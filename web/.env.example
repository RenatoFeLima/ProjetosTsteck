# ============================================================================
# .env.example — Pipeline de Projetos TSTECK
# Copie para .env.local e preencha os valores. NUNCA commite .env.local.
# Variáveis de banco/SMTP são SERVER-SIDE: jamais use prefixo NEXT_PUBLIC_ nelas.
# ============================================================================

# ─── Banco de dados MySQL (Hostinger) ───────────────────────────────────────
DATABASE_HOST=srv1886.hstgr.io
DATABASE_PORT=3306
DATABASE_NAME=u180894979_ProjetosTsTeck
DATABASE_USER=u180894979_TsTeckProjetos
DATABASE_PASSWORD=
# Prisma usa apenas DATABASE_URL. URL-encode caracteres especiais da senha.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

APP_TIMEZONE=America/Sao_Paulo

# ─── Seed do administrador inicial ──────────────────────────────────────────
INITIAL_ADMIN_USERNAME=RenatoFerreira
INITIAL_ADMIN_NAME="Renato Ferreira"
INITIAL_ADMIN_PASSWORD=

# ─── Sessão / Autenticação (JWT em cookie HTTP-only) ────────────────────────
# Gere: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
AUTH_SESSION_HOURS=12

# ─── SMTP / E-mail ──────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TSTECK Projetos <ativoststeck@gmail.com>"
# Notificacoes automaticas vao SOMENTE para o vendedor responsavel do projeto.
# (PROJECTS_TEAM_EMAIL foi removido — sem copia/CC para o time.)

# ─── Verificação de prazos (cron client-side) ───────────────────────────────
CRON_SECRET=
NEXT_PUBLIC_CRON_SECRET=

# ─── Rate limiting (Upstash Redis) — OPCIONAL ───────────────────────────────
# Se preenchidas, o limite de tentativas de login usa Redis (distribuído, ideal
# para serverless/Vercel). Sem elas, cai para um limitador em memória por
# instância (funciona, mas não compartilhado entre instâncias).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Origens permitidas (CSRF) — OPCIONAL ───────────────────────────────────
# Lista separada por vírgula de origens extras além da produção/Vercel.
# Ex.: https://app.exemplo.com,https://outra.exemplo.com
APP_ALLOWED_ORIGINS=
